NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/ai_network_analyzer

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_EXPLANATION_ENABLED=false
AI_PRIVACY_MODE=redacted

PYTHON_EXECUTABLE=python
PYTHON_ML_SERVICE_DIR=./ml_service

ML_TRAIN_DATA_DIR=ml_service/data/raw/cse_cic_ids2018_processed
ML_TRAIN_LABEL_MODE=grouped
ML_TRAIN_OUTPUT_DIR=ml_service/models
ML_TRAIN_LOAD_MODE=full
ML_TRAIN_CHUNKSIZE=100000
ML_TRAIN_MAX_ROWS_PER_CLASS=25000
ML_TRAIN_MAX_TOTAL_ROWS=400000
ML_TRAIN_MAX_ROWS_PER_FILE=250000
ML_TRAIN_N_ESTIMATORS=200
ML_TRAIN_RANDOM_STATE=42

CAPTURE_WINDOW_SECONDS=5
CAPTURE_INTERFACE=
SIEM_EXPORT_DIR=./exports
